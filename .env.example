# Chỉ placeholder. Không commit giá trị thật. Xem docs/ARCHITECTURE.md §1.

# Nguồn dữ liệu: "mock" (M0–M3, chỉ dev/test) hoặc "supabase" (M4+). Production bắt buộc "supabase".
NEXT_PUBLIC_DATA_SOURCE=mock

# Supabase (từ M4). URL và publishable key được phép public; KHÔNG đặt service_role ở biến NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chỉ server (cron nộp bài tự động, nếu cần ở M6). Không bao giờ đưa vào client/log.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
